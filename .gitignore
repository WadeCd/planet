# Godot 4+ specific ignores
.godot/
/android/

# 录像/成品等大体积媒体不入库（markers.json、字幕稿、文案仍然入库）
content/sessions/**/*.mkv
content/sessions/**/*.mp4
content/sessions/**/*.flv
content/publish/**/*.mkv
content/publish/**/*.mp4
content/publish/**/*.mp3
content/publish/**/*.wav

# 录制期运行期产物（不入库）
content/sessions/**/.ffmpeg.log
content/sessions/**/.recording.pid
content/sessions/**/.stop-request
content/sessions/**/take.srt
content/sessions/**/take.txt
**/*.tmp

# Godot 会为入库的音频/媒体生成 .import；被忽略的媒体其 .import 一并忽略
content/publish/**/*.mp3.import

# 本地工作文件（不进仓库）
task-load/

# Python
__pycache__/
*.pyc